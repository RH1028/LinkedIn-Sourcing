{
  "manifest_version": 3,
  "name": "LinkedIn Sourcing PoC",
  "version": "0.0.1",
  "description": "Phase 0 de-risk: verify a content script can read Sales Navigator search results without triggering LinkedIn detection.",
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/sales/search/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Sourcing PoC"
  }
}
